# Copy to .env.local (git-ignored) and adjust. Vite only exposes REACT_APP_* to the app.

# Local Supabase stack (supabase start). The key below is the CLI's public demo anon key.
REACT_APP_SUPABASE_URL=http://127.0.0.1:54321
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Where links and assets point; leave empty to use the page's own address
# (works for `npm start` and `npm run preview` on any port).
REACT_APP_PUBLIC_URL=

# Without REACT_APP_SUPABASE_URL, `npm start` warns and the page won't load, and
# `npm run build` fails (except on Netlify).
# Set this only if you really mean to use production data.
# REACT_APP_ALLOW_PROD_DB=true

# Read from the shell, not this file: PORT (dev server, default 3000) and
# BUILD_PATH (build output, default build).

# Only for `npm run import-bulletin`, also from the shell (see docs/github-actions.md)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# BULLETIN_IMPORTER_TOKEN=
